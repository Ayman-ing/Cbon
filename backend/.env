# Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:8000

PGHOST=localhost
PGPORT=5432
PGUSER=cbonuser
PGPASSWORD=cbonpass
PGDATABASE=cbon_db



# Auth / Security
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=7d
SESSION_SECRET=replace_with_a_different_strong_secret
SALT_ROUNDS=10




# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Monitoring / Logging
LOG_LEVEL=info
SENTRY_DSN=

# CORS / Rate limit
CORS_ORIGIN=http://localhost:8000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100